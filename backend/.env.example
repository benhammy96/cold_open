# Cold Open backend configuration. Copy to .env for local use, or set these as
# environment variables on your host. All app vars use the COLDOPEN_ prefix,
# except DATABASE_URL (which managed hosts like Render inject directly).

# --- Database ---
# Managed hosts inject DATABASE_URL. 'postgres://' is normalized automatically.
# Leave unset locally to use the default SQLite file (sqlite:///./cold_open.db).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Security ---
# Secret for signing per-run tokens (R50). Set a long random value in prod.
# COLDOPEN_TOKEN_SECRET=change-me-to-a-long-random-string

# --- CORS ---
# Comma-separated browser origins allowed to call the API. In prod this is the
# deployed frontend URL; locally it defaults to the Vite dev server.
# COLDOPEN_CORS_ORIGINS=https://cold-open-web.onrender.com

# --- Content strictness ---
# On real TMDB data, enforce the §4 rule of >= 40 answers per prompt.
# Leave false (default) when running on the keyless fixture catalog.
# COLDOPEN_STRICT_CONTENT=true

# --- TMDB (Task 8) ---
# Set ONE of these to ingest the real catalog instead of fixtures.
# TMDB_API_KEY=your_v3_api_key
# TMDB_READ_TOKEN=your_v4_bearer_token
